# Optional: copy this file to .env in the project root.
# Default deployment is reachable only from the Docker host.
GEOAI_PUBLISH_IP=127.0.0.1
GEOAI_HTTP_PORT=8020
GEOAI_ALLOWED_HOSTS=localhost,127.0.0.1

# Trusted-LAN example: change the address to the actual server IP/hostname.
# GEOAI_PUBLISH_IP=0.0.0.0
# GEOAI_ALLOWED_HOSTS=192.168.1.50,agri.internal.example
